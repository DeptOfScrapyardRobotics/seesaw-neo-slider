{
    "name": "dept-of-scrapyard-robotics/seesaw-neo-slider",
    "description": "Drive the Adafruit NeoSlider I2C QT Slide Potentiometer over I2C with PHP",
    "type": "library",
    "version": "0.7.0",
    "keywords": [
        "seesaw",
        "neoslider",
        "potentiometer",
        "neopixel",
        "scrapyard-io"
    ],
    "license": "MIT",
    "homepage": "https://dosr.projectsaturnstudios.com",
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "^8.4|^8.5|^8.6",
        "fabricate/nuts-and-bolts": "^0.7.0",
        "gpio/circuits": "^0.7.0",
        "gpio/contracts": "^0.7.0",
        "gpio/i2c": "^0.7.0",
        "waveforms/contracts": "^0.7.0"
    },
    "require-dev": {
        "pestphp/pest": "^4"
    },
    "suggest": {
        "microscrap/i2c": "^0.7.0 - POSIX I2C",
        "microscrap/mpsse": "^0.7.0 - I2C over FTDI MPSSE"
    },
    "autoload": {
        "psr-4": {
            "DeptOfScrapyardRobotics\\Actuators\\SeesawNeoSlider\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DeptOfScrapyardRobotics\\Actuators\\SeesawNeoSlider\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "0.7.x-dev"
        },
        "scrapyard-io": {
            "providers": [
                "DeptOfScrapyardRobotics\\Actuators\\SeesawNeoSlider\\SeesawNeoSliderServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
