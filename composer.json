{
    "name": "dept-of-scrapyard-robotics/seesaw-neo-slider",
    "description": "Drive the Adafruit NeoSlider I2C QT Slide Potentiometer over I2C with PHP",
    "type": "library",
    "version": "0.6.1",
    "license": "MIT",
    "homepage": "https://dosr.projectsaturnstudios.com",
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "^8.4|^8.5|^8.6",
        "fabricate/actuation": "^0.6.0",
        "fabricate/circuits": "^0.6.0",
        "fabricate/nuts-and-bolts": "^0.6.0",
        "gpio/contracts": "^0.6.0",
        "gpio/i2c": "^0.6.0"
    },
    "require-dev": {
        "pestphp/pest": "^4",
        "scrapyard-io/waveforms": "^0.6.0"
    },
    "autoload": {
        "psr-4": {
            "DeptOfScrapyardRobotics\\Actuators\\SeesawNeoSlider\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DeptOfScrapyardRobotics\\Actuators\\SeesawNeoSlider\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "0.6.x-dev"
        },
        "scrapyard-io": {
            "providers": [
                "DeptOfScrapyardRobotics\\Actuators\\SeesawNeoSlider\\Providers\\SeesawNeoSliderServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
